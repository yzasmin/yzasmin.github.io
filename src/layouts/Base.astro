---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { person } from '../data/profile';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
}

const siteName = `${person.firstName} ${person.lastName}, Data Scientist, Data Analyst, Data Engineer`;
const {
  title = siteName,
  description = 'Portfolio de Yasmina Saoud : data science, analyse de données et data engineering à Montpellier et Béziers. Master MIASHS, deux ans d’alternance data, projets documentés.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url('video/intro-poster.jpg'), Astro.site);
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: `${person.firstName} ${person.lastName}`,
  jobTitle: 'Data Scientist, Data Analyst, Data Engineer',
  email: `mailto:${person.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Montpellier', addressCountry: 'FR' },
  alumniOf: 'Université Paul Valéry Montpellier 3',
  sameAs: [person.linkedin, person.github],
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta name="theme-color" content="#0d0f12" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f3f1ea" media="(prefers-color-scheme: light)" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)}></script>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') root.dataset.theme = saved;
        } catch {}
      })();
    </script>
  </head>
  <body class="min-h-dvh overflow-x-clip">
    <a href="#contenu" class="btn btn-primary fixed top-3 left-3 z-[100] -translate-y-24 focus:translate-y-0">
      Aller au contenu
    </a>
    <Header />
    <main id="contenu" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <footer class="mx-auto mt-24 max-w-7xl px-5 md:px-8">
      <div class="mono-label flex flex-col gap-2 border-t border-rule py-8 sm:flex-row sm:justify-between">
        <span>
          © {new Date().getFullYear()} {person.firstName} {person.lastName}
        </span>
        <span>Construit avec Astro, Tailwind CSS et GSAP</span>
      </div>
    </footer>
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
