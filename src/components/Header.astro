---
import { url } from '../lib/url';

const links = [
  { href: url('#a-propos'), label: 'À propos' },
  { href: url('#stack'), label: 'Stack' },
  { href: url('#projets'), label: 'Projets' },
  { href: url('#parcours'), label: 'Parcours' },
  { href: url('#contact'), label: 'Contact' },
];
---

<header class="sticky top-0 z-50 border-b border-rule/70 bg-paper/80 backdrop-blur-md supports-[backdrop-filter]:bg-paper/65">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-5 md:px-8">
    <a href={url()} class="group flex items-center gap-3">
      <span
        aria-hidden="true"
        class="grid size-9 place-items-center border border-ink font-display text-sm font-extrabold transition-colors group-hover:border-signal group-hover:bg-signal group-hover:text-paper"
      >
        YS
      </span>
      <span class="sr-only font-display text-lg font-bold tracking-tight sm:not-sr-only">Yasmina Saoud</span>
      <span class="sr-only">, accueil</span>
    </a>

    <nav aria-label="Navigation principale" class="hidden lg:block">
      <ul class="flex items-center gap-7">
        {links.map((link, index) => (
          <li>
            <a href={link.href} class="group mono-label !text-ink hover:!text-signal">
              <span class="text-signal">0{index + 1}</span> {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <button
        type="button"
        data-theme-toggle
        class="grid size-10 place-items-center border border-rule transition-colors hover:border-ink"
        aria-label="Basculer le thème clair ou sombre"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor"></path>
        </svg>
      </button>
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="menu-mobile"
        class="grid size-10 place-items-center border border-rule lg:hidden"
      >
        <span class="sr-only">Ouvrir le menu</span>
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M3 7h18M3 12h18M3 17h18"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="menu-mobile" aria-label="Navigation mobile" class="hidden border-t border-rule lg:hidden" data-menu>
    <ul class="mx-auto max-w-7xl px-5 py-3">
      {links.map((link, index) => (
        <li>
          <a href={link.href} class="flex items-baseline gap-3 py-3 font-display text-2xl font-bold">
            <span class="mono-label !text-signal">0{index + 1}</span>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const root = document.documentElement;
  const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');
  const currentTheme = () => root.dataset.theme ?? (prefersDark.matches ? 'dark' : 'light');

  const syncThemeButton = () => {
    const next = currentTheme() === 'dark' ? 'clair' : 'sombre';
    themeButton?.setAttribute('aria-label', `Passer au thème ${next}`);
  };
  syncThemeButton();
  prefersDark.addEventListener('change', syncThemeButton);

  themeButton?.addEventListener('click', () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    syncThemeButton();
  });

  const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const setMenu = (open: boolean) => {
    menuButton?.setAttribute('aria-expanded', String(open));
    menu?.classList.toggle('hidden', !open);
    const label = menuButton?.querySelector('.sr-only');
    if (label) label.textContent = open ? 'Fermer le menu' : 'Ouvrir le menu';
  };
  menuButton?.addEventListener('click', () => setMenu(menuButton.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setMenu(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      menuButton.focus();
    }
  });
</script>
