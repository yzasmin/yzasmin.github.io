---
interface Props {
  id: string;
  fig: string;
  label: string;
  title: string;
  intro?: string;
}

const { id, fig, label, title, intro } = Astro.props;
---

<div class="mb-12 md:mb-16">
  <div class="mono-label flex items-center gap-4">
    <span>
      <span class="text-signal">FIG. {fig}</span> / {label}
    </span>
    <span class="h-px flex-1 bg-rule" data-draw aria-hidden="true"></span>
  </div>
  <div class="ticks mt-2 opacity-70" aria-hidden="true"></div>
  <div class="mt-8 grid gap-6 lg:grid-cols-12 lg:items-end">
    <h2 id={id} class="display text-[clamp(2.6rem,7vw,5.5rem)] lg:col-span-7" data-reveal>
      {title}
    </h2>
    {intro && (
      <p class="max-w-xl text-lg text-ink-2 lg:col-span-5" data-reveal>
        {intro}
      </p>
    )}
  </div>
</div>
