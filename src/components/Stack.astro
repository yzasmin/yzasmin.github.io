---
import SectionHead from './SectionHead.astro';
import { families, stack, type Family } from '../data/profile';

const toolCount = new Set(stack.flatMap((row) => row.tools)).size;
const familyCounts = (Object.keys(families) as Family[]).map((family) => ({
  family,
  count: stack.filter((row) => row.family === family).length,
}));
---

<section id="stack" aria-labelledby="stack-titre" class="mx-auto max-w-7xl px-5 py-14 md:px-8 md:py-24">
  <SectionHead
    id="stack-titre"
    fig="02"
    label="Stack"
    title="Boîte à outils."
    intro={`${stack.length} catégories, ${toolCount} outils et méthodes, classés par domaine. Pas de jauge de niveau : les projets servent de preuve.`}
  />

  <ul class="mb-8 flex flex-wrap gap-x-6 gap-y-2" aria-label="Légende des domaines" data-reveal>
    {familyCounts.map(({ family, count }) => (
      <li class="mono-label flex items-center gap-2 !text-ink">
        <span class="dot" style={`background:${families[family].color}`} aria-hidden="true" />
        {families[family].label}
        <span class="text-ink-2">({count})</span>
      </li>
    ))}
  </ul>

  <div class="border-t border-ink" role="table" aria-label="Stack technique par catégorie">
    <div role="rowgroup" class="sr-only">
      <div role="row">
        <span role="columnheader">Numéro</span>
        <span role="columnheader">Catégorie</span>
        <span role="columnheader">Outils</span>
        <span role="columnheader">Nombre</span>
      </div>
    </div>
    <div role="rowgroup">
      {stack.map((row, index) => (
        <div
          role="row"
          class="group grid grid-cols-[2.5rem_1fr_auto] items-start gap-x-4 gap-y-3 border-b border-rule py-4 transition-colors hover:bg-paper-2/60 md:grid-cols-[3.5rem_15rem_1fr_3rem] md:items-center md:px-2"
          data-reveal
        >
          <span role="cell" class="mono-label pt-1 md:pt-0">
            {String(index + 1).padStart(2, '0')}
          </span>
          <span role="cell" class="flex items-center gap-3 font-display text-xl font-bold tracking-tight md:text-2xl">
            <span class="dot" style={`background:${families[row.family].color}`} aria-hidden="true" />
            {row.category}
          </span>
          <span role="cell" class="col-span-3 md:col-span-1 md:col-start-3 md:row-start-1">
            <ul class="flex flex-wrap gap-1.5">
              {row.tools.map((tool) => (
                <li class="chip group-hover:border-ink-2">{tool}</li>
              ))}
            </ul>
          </span>
          <span
            role="cell"
            class="mono-label col-start-3 row-start-1 pt-1 text-right !normal-case md:col-start-4 md:pt-0"
          >
            n={row.tools.length}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
