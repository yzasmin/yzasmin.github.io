---
import { cvFiles, families, person, search } from '../data/profile';
import { url } from '../lib/url';

const nameLines = [person.firstName, `${person.lastName}.`];

// Ce que cherche Yasmina : placé sous le nom, donc visible sur le premier écran, y compris en 375 px.
const searchItems = [
  { label: 'Contrat recherché', value: search.contract, accent: true },
  { label: 'Mobilité', value: search.mobility, accent: false },
  { label: 'Disponibilité', value: search.availability, accent: false },
];

const facts = [
  { label: 'Diplôme', value: 'Master MIASHS, mention Bien' },
  { label: 'Certification', value: 'NVIDIA, Generative AI with Diffusion Models' },
  { label: 'Expérience', value: "2 ans d'alternance data, 5 ans d'activité indépendante" },
  { label: 'Code public', value: '6 projets documentés, chiffres vérifiables' },
];
---

<section aria-labelledby="hero-title" class="relative mx-auto max-w-7xl px-5 pt-6 pb-12 md:px-8 md:pt-12 lg:pb-20">
  <div class="mono-label flex items-center justify-between gap-4" data-hero-fade>
    <span>
      <span class="text-signal">FIG. 00</span> / PROFIL
    </span>
    <span class="hidden sm:inline">43.61° N · 3.88° E · Hérault</span>
  </div>
  <div class="ticks mt-2 opacity-70" aria-hidden="true"></div>

  <div class="mt-6 grid gap-10 lg:mt-12 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-7">
      <h1
        id="hero-title"
        class="display text-[clamp(3.1rem,12vw,9.5rem)]"
        aria-label={`${person.firstName} ${person.lastName}`}
      >
        {nameLines.map((line) => (
          <span class="block overflow-hidden pb-[0.06em]" aria-hidden="true">
            {[...line].map((char) => (
              <span class="inline-block" data-hero-char>
                {char}
              </span>
            ))}
          </span>
        ))}
      </h1>

      <ul class="mt-6 flex flex-wrap gap-2" aria-label="Postes visés" data-hero-fade>
        {person.roles.map((role) => (
          <li class="chip !text-sm">
            <span class="dot" style={`background:${families[role.family].color}`} aria-hidden="true" />
            {role.label}
          </li>
        ))}
      </ul>

      {/* Pas d'animation sur ce bloc ni sur le paragraphe suivant : ce sont les deux éléments qu'un
          service RH doit lire sans attendre le JavaScript, et le paragraphe est l'élément LCP. */}
      <dl class="mt-6 max-w-2xl divide-y divide-rule border-y border-ink">
        {searchItems.map((item) => (
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 py-2.5">
            <dt class="mono-label flex w-40 shrink-0 items-center gap-2 md:w-44">
              {item.accent && <span class="dot bg-signal" aria-hidden="true" />}
              {item.label}
            </dt>
            <dd class:list={['flex-1 leading-snug font-medium', item.accent && 'text-signal']}>{item.value}</dd>
          </div>
        ))}
      </dl>

      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-2 md:text-xl">{person.pitch}</p>

      <div class="mt-7 flex flex-wrap items-center gap-3" data-hero-fade>
        <a href={url('#projets')} class="btn btn-primary">
          Voir les projets
          <span aria-hidden="true">↓</span>
        </a>
        <details class="group relative" data-cv-menu>
          <summary class="btn btn-ghost cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            Télécharger le CV
            <span aria-hidden="true" class="transition-transform group-open:rotate-180">
              ▾
            </span>
          </summary>
          <ul class="absolute left-0 z-20 mt-2 w-80 max-w-[calc(100vw-2.5rem)] border border-ink bg-paper p-1 shadow-[6px_6px_0_var(--rule)]">
            {cvFiles.map((cv) => (
              <li>
                <a
                  href={url(cv.file)}
                  download
                  class="flex items-center justify-between px-3 py-2.5 text-sm hover:bg-paper-2"
                >
                  <span>CV {cv.label}</span>
                  <span class="mono-label">PDF</span>
                </a>
              </li>
            ))}
          </ul>
        </details>
        <a href={person.github} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
          <svg class="size-4 shrink-0" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
          </svg>
          GitHub
          <span class="sr-only">, yzasmin (nouvel onglet)</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <div class="flex flex-col gap-8 lg:col-span-5 lg:justify-between">
      <dl class="grid grid-cols-2 border-t border-l border-rule" data-hero-fade>
        {facts.map((fact) => (
          <div class="border-r border-b border-rule p-4">
            <dt class="mono-label">{fact.label}</dt>
            <dd class="mt-1.5 font-medium leading-snug">{fact.value}</dd>
          </div>
        ))}
      </dl>
      <figure data-hero-fade>
        <div class="brackets border border-rule bg-[#0d0f12]">
          <video
            class="aspect-video w-full object-cover"
            data-hero-video
            muted
            loop
            playsinline
            preload="none"
            poster={url('video/intro-poster.jpg')}
            aria-label="Vidéo d'introduction animée : nuage de points qui se regroupe en trois domaines, Data Science, Data Analysis et Data Engineering, puis le nom Yasmina Saoud et trois faits clés."
          >
            <source src={url('video/intro.webm')} type="video/webm" />
            <source src={url('video/intro.mp4')} type="video/mp4" />
          </video>
        </div>
        <figcaption class="mono-label mt-4 flex items-center justify-between gap-4">
          <span>Fig. 00. Introduction, 12 s</span>
          <button
            type="button"
            data-video-toggle
            class="link-underline !text-ink hover:!text-signal"
            aria-pressed="false"
          >
            Lire
          </button>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-video-toggle]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const render = () => {
    if (!video || !toggle) return;
    const playing = !video.paused;
    toggle.textContent = playing ? 'Pause' : 'Lire';
    toggle.setAttribute('aria-pressed', String(playing));
  };

  const cvMenu = document.querySelector<HTMLDetailsElement>('[data-cv-menu]');
  const closeCvMenu = (returnFocus: boolean) => {
    if (!cvMenu?.open) return;
    cvMenu.open = false;
    if (returnFocus) cvMenu.querySelector('summary')?.focus();
  };
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeCvMenu(true);
  });
  document.addEventListener('click', (event) => {
    if (cvMenu && !cvMenu.contains(event.target as Node)) closeCvMenu(false);
  });

  if (video && toggle) {
    video.addEventListener('play', render);
    video.addEventListener('pause', render);
    toggle.addEventListener('click', () => (video.paused ? video.play() : video.pause()));
    if (!reduceMotion) video.play().catch(render);
  }
</script>
