---
import { cvFiles, families, person } from '../data/profile';
import { url } from '../lib/url';

const nameLines = [person.firstName, `${person.lastName}.`];
const facts = [
  { label: 'Localisation', value: person.location },
  { label: 'Disponibilité', value: person.availability },
  { label: 'Diplôme', value: 'Master MIASHS, mention Bien' },
  { label: 'Certification', value: 'NVIDIA, Generative AI with Diffusion Models' },
];
---

<section aria-labelledby="hero-title" class="relative mx-auto max-w-7xl px-5 pt-10 pb-16 md:px-8 md:pt-16 lg:pb-24">
  <div class="mono-label flex items-center justify-between gap-4" data-hero-fade>
    <span>
      <span class="text-signal">FIG. 00</span> / PROFIL
    </span>
    <span class="hidden sm:inline">43.61° N · 3.88° E · Hérault</span>
  </div>
  <div class="ticks mt-2 opacity-70" aria-hidden="true"></div>

  <div class="mt-10 grid gap-12 lg:mt-14 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-7">
      <h1
        id="hero-title"
        class="display text-[clamp(4rem,13.5vw,10.5rem)]"
        aria-label={`${person.firstName} ${person.lastName}`}
      >
        {nameLines.map((line) => (
          <span class="block overflow-hidden pb-[0.06em]" aria-hidden="true">
            {[...line].map((char) => (
              <span class="inline-block" data-hero-char>
                {char}
              </span>
            ))}
          </span>
        ))}
      </h1>

      <ul class="mt-8 flex flex-wrap gap-2" aria-label="Postes visés" data-hero-fade>
        {person.roles.map((role) => (
          <li class="chip !text-sm">
            <span class="dot" style={`background:${families[role.family].color}`} aria-hidden="true" />
            {role.label}
          </li>
        ))}
      </ul>

      <!-- Pas d'animation ici : ce paragraphe est l'élément LCP, il doit s'afficher sans attendre le JavaScript. -->
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-2 md:text-xl">{person.pitch}</p>

      <div class="mt-9 flex flex-wrap items-center gap-3" data-hero-fade>
        <a href={url('#projets')} class="btn btn-primary">
          Voir les projets
          <span aria-hidden="true">↓</span>
        </a>
        <details class="group relative" data-cv-menu>
          <summary class="btn btn-ghost cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            Télécharger le CV
            <span aria-hidden="true" class="transition-transform group-open:rotate-180">
              ▾
            </span>
          </summary>
          <ul class="absolute left-0 z-20 mt-2 w-80 max-w-[calc(100vw-2.5rem)] border border-ink bg-paper p-1 shadow-[6px_6px_0_var(--rule)]">
            {cvFiles.map((cv) => (
              <li>
                <a
                  href={url(cv.file)}
                  download
                  class="flex items-center justify-between px-3 py-2.5 text-sm hover:bg-paper-2"
                >
                  <span>CV {cv.label}</span>
                  <span class="mono-label">PDF</span>
                </a>
              </li>
            ))}
          </ul>
        </details>
      </div>
    </div>

    <div class="flex flex-col gap-10 lg:col-span-5 lg:justify-between">
      <dl class="order-2 grid grid-cols-2 border-t border-l border-rule lg:order-1" data-hero-fade>
        {facts.map((fact) => (
          <div class="border-r border-b border-rule p-4">
            <dt class="mono-label">{fact.label}</dt>
            <dd class="mt-1.5 font-medium leading-snug">{fact.value}</dd>
          </div>
        ))}
      </dl>
      <figure class="order-1 lg:order-2" data-hero-fade>
        <div class="brackets border border-rule bg-[#0d0f12]">
          <video
            class="aspect-video w-full object-cover"
            data-hero-video
            muted
            loop
            playsinline
            preload="none"
            poster={url('video/intro-poster.jpg')}
            aria-label="Vidéo d'introduction animée : nuage de points qui se regroupe en trois domaines, Data Science, Data Analysis et Data Engineering, puis le nom Yasmina Saoud et trois faits clés."
          >
            <source src={url('video/intro.webm')} type="video/webm" />
            <source src={url('video/intro.mp4')} type="video/mp4" />
          </video>
        </div>
        <figcaption class="mono-label mt-4 flex items-center justify-between gap-4">
          <span>Fig. 00. Introduction, 12 s</span>
          <button
            type="button"
            data-video-toggle
            class="link-underline !text-ink hover:!text-signal"
            aria-pressed="false"
          >
            Lire
          </button>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-video-toggle]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const render = () => {
    if (!video || !toggle) return;
    const playing = !video.paused;
    toggle.textContent = playing ? 'Pause' : 'Lire';
    toggle.setAttribute('aria-pressed', String(playing));
  };

  const cvMenu = document.querySelector<HTMLDetailsElement>('[data-cv-menu]');
  const closeCvMenu = (returnFocus: boolean) => {
    if (!cvMenu?.open) return;
    cvMenu.open = false;
    if (returnFocus) cvMenu.querySelector('summary')?.focus();
  };
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeCvMenu(true);
  });
  document.addEventListener('click', (event) => {
    if (cvMenu && !cvMenu.contains(event.target as Node)) closeCvMenu(false);
  });

  if (video && toggle) {
    video.addEventListener('play', render);
    video.addEventListener('pause', render);
    toggle.addEventListener('click', () => (video.paused ? video.play() : video.pause()));
    if (!reduceMotion) video.play().catch(render);
  }
</script>
